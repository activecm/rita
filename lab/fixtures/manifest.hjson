      purpose: "DNS-specific import and feature-query coverage."
    }
  ]
  metrics: {
    parse_success_rate: "not_measured"
    query_latency: "not_measured"
    aggregation_reduction: "not_measured"
    false_positive_rate: "not_measured"
    detection_coverage: "not_measured"
    alert_latency: "not_measured"
    allowlist_effect: "not_measured"
  }
}
